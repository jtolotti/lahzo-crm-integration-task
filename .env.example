# HubSpot — Single Legacy App (OAuth for API access + webhook signature verification)
HUBSPOT_CLIENT_ID=your-app-client-id
HUBSPOT_CLIENT_SECRET=your-app-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:3000/hubspot/auth/callback
HUBSPOT_PORTAL_ID=12345678

# ngrok (exposes local server for HubSpot webhook delivery)
NGROK_AUTHTOKEN=xxxx

# PostgreSQL
DATABASE_URL=postgresql://lahzo:lahzo@localhost:5432/lahzo

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=your-secret-key-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Seed Credentials (for reviewer login)
# admin@lahzo.dev / admin123
# reviewer@lahzo.dev / reviewer123
